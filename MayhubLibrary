local function MakeDraggable(dragObject, targetObject)
	local dragStart
	local startPos

	local function update(input)
		local delta = input.Position - dragStart
		targetObject.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end

	dragObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragStart = input.Position
			startPos = targetObject.Position
			ActiveDrag = update
		end
	end)
end

MakeDraggable(Header, MainFrame)

local function MakeResizable(handle, targetObject, minSize)
	local dragStart
	local startSize

	local function update(input)
		local delta = input.Position - dragStart
		local newWidth = math.max(minSize.X.Offset, startSize.X.Offset + delta.X)
		local newHeight = math.max(minSize.Y.Offset, startSize.Y.Offset + delta.Y)
		targetObject.Size = UDim2.new(0, newWidth, 0, newHeight)
	end

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragStart = input.Position
			startSize = targetObject.Size
			ActiveDrag = update
		end
	end)
end

