				Text = "✓",
				TextColor3 = Color3.fromRGB(255, 255, 255),
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextTransparency = isSelected and 0 or 1,
				ZIndex = 6,
				Parent = CheckBox,
			})

			Create("TextLabel", {
				Size = UDim2.new(1, -34, 1, 0),
				Position = UDim2.new(0, 32, 0, 0),
				BackgroundTransparency = 1,
				Text = option,
				TextColor3 = Theme.Text,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 6,
				Parent = OptionBtn,
			})

			checkboxes[option] = {Box = CheckBox, Mark = CheckMark}

			OptionBtn.MouseButton1Click:Connect(function()
				selected[option] = not selected[option]
				local nowSelected = selected[option] == true
				Tween(CheckBox, {BackgroundColor3 = nowSelected and Theme.Accent or Theme.Background}, 0.15)
				Tween(CheckMark, {TextTransparency = nowSelected and 0 or 1}, 0.15)
				SelectedLabel.Text = GetSelectedText()
				if config.Callback then
					config.Callback(GetSelectedList())
				end
			end)
		end

		local ClickArea = Create("TextButton", {
