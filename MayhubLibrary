	guiOpen = true
	MainFrame.Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, 0)
	MainFrame.Visible = true
	Tween(MainFrame, {Size = savedSize}, 0.35, Enum.EasingStyle.Back)
end

local function CloseGUI()
	savedSize = MainFrame.Size
	guiOpen = false
	Tween(MainFrame, {Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, 0)}, 0.25)
	task.delay(0.25, function()
		if not guiOpen then
			MainFrame.Visible = false
		end
	end)
end

local function ToggleGUI()
	if guiOpen then
		CloseGUI()
	else
		OpenGUI()
	end
end

