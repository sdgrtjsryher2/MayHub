	function TabAPI:CreateSlider(config)
		config = config or {}
		ElementOrder += 1
		local min = config.Min or 0
		local max = config.Max or 100
		local default = config.Default or min
		local suffix = config.Suffix or ""
		local toAdd = config.ToAdd or 1

		local decimals = 0
		do
			local s = tostring(toAdd)
			local dot = s:find("%.")
			if dot then
				decimals = #s - dot
			end
		end

		local function FormatValue(v)
			if decimals > 0 then
				return string.format("%." .. decimals .. "f", v)
			else
				return tostring(math.floor(v + 0.0001))
			end
		end

		local function SnapToStep(v)
			local steps = math.floor((v - min) / toAdd + 0.5)
			local snapped = min + steps * toAdd
			return math.clamp(snapped, min, max)
		end

		default = SnapToStep(default)

		local SliderFrame = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 50),
			BackgroundColor3 = Theme.Secondary,
			ClipsDescendants = true,
			LayoutOrder = ElementOrder,
			Parent = Page,
		})
		AddCorner(SliderFrame, 8)
		AddStroke(SliderFrame, Theme.Stroke, 1)
		Create("TextLabel", {
			Size = UDim2.new(1, -80, 0, 20),
			Position = UDim2.new(0, 12, 0, 6),
			BackgroundTransparency = 1,
			Text = config.Name or "Slider",
			TextColor3 = Theme.Text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = SliderFrame,
		})

		local ValueLabel = Create("TextLabel", {
			Size = UDim2.new(0, 60, 0, 20),
			Position = UDim2.new(1, -72, 0, 6),
			BackgroundTransparency = 1,
			Text = FormatValue(default) .. suffix,
			TextColor3 = Theme.Accent,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = SliderFrame,
		})
		local SliderTrack = Create("Frame", {
			Size = UDim2.new(1, -24, 0, 6),
			Position = UDim2.new(0, 12, 0, 32),
			BackgroundColor3 = Theme.Tertiary,
			Parent = SliderFrame,
		})
		AddCorner(SliderTrack, 3)
		local percentage = (default - min) / (max - min)
		local SliderFill = Create("Frame", {
			Size = UDim2.new(percentage, 0, 1, 0),
			BackgroundColor3 = Theme.Accent,
			Parent = SliderTrack,
		})
		AddCorner(SliderFill, 3)
		AddGradient(SliderFill, ColorSequence.new(Theme.Accent, Theme.AccentSecondary), 0)
		local SliderDot = Create("Frame", {
			Size = UDim2.new(0, 14, 0, 14),
			Position = UDim2.new(percentage, -7, 0.5, -7),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Parent = SliderTrack,
		})
		AddCorner(SliderDot, 7)
		AddStroke(SliderDot, Theme.Accent, 2)

		local currentValue = default

		local function UpdateSlider(input)
			local relativeX = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
			local rawValue = min + (max - min) * relativeX
			local value = SnapToStep(rawValue)
			local newRelativeX = (value - min) / (max - min)

			if value == currentValue then return end
			currentValue = value

			SliderFill.Size = UDim2.new(newRelativeX, 0, 1, 0)
			SliderDot.Position = UDim2.new(newRelativeX, -7, 0.5, -7)
			ValueLabel.Text = FormatValue(value) .. suffix
			if config.Callback then
				config.Callback(value)
			end
		end

		SliderTrack.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				UpdateSlider(input)
				ActiveDrag = UpdateSlider
			end
		end)

		if config.IsLocked then
			AddLockOverlay(SliderFrame, 8, nil, true, 10)
		end

		return {
			Frame = SliderFrame,
			Get = function() return currentValue end,
			Set = function(newValue)
				newValue = SnapToStep(newValue)
				currentValue = newValue
				local relativeX = (newValue - min) / (max - min)
				SliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
				SliderDot.Position = UDim2.new(relativeX, -7, 0.5, -7)
				ValueLabel.Text = FormatValue(newValue) .. suffix
				if config.Callback then
					config.Callback(newValue)
				end
			end,
		}
	end

