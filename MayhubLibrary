local function CheckKey()
	local enteredKey = KeyTextBox.Text
	local valid = false
	for _, k in ipairs(VALID_KEYS) do
		if enteredKey == k then
			valid = true
			break
		end
	end

	if valid then
		KeySystemPassed = true
		KeyStatusLabel.TextColor3 = Theme.Success
		KeyStatusLabel.Text = "Key accepted! Loading..."
		task.wait(0.4)
		Tween(KeyOverlay, {Size = UDim2.new(0, 320, 0, 0)}, 0.25)
		task.wait(0.25)
		KeyOverlay.Visible = false
		OpenGUI()
	else
		KeyStatusLabel.TextColor3 = Color3.fromRGB(230, 80, 80)
		KeyStatusLabel.Text = "Invalid key. Try again."
		Tween(KeyInputFrame, {BackgroundColor3 = Color3.fromRGB(60, 25, 25)}, 0.1)
		task.wait(0.15)
		Tween(KeyInputFrame, {BackgroundColor3 = Theme.Secondary}, 0.2)
	end
end

SubmitButton.MouseButton1Click:Connect(function()
	Tween(SubmitButton, {BackgroundColor3 = Theme.AccentSecondary}, 0.1)
	task.wait(0.1)
	CheckKey()
end)

KeyTextBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		CheckKey()
	end
end)

