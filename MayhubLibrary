local function CreateColorPickerInstance(config)
	config = config or {}
	local hue, sat, val = 0, 1, 1
	do
		local c = config.Default or Color3.fromRGB(255, 0, 0)
		hue, sat, val = c:ToHSV()
	end

	local isOpen = false

	local function CurrentColor()
		return Color3.fromHSV(hue, sat, val)
	end

	local function RefreshCursors()
		SVBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		SVCursor.Position = UDim2.new(sat, 0, 1 - val, 0)
		HueCursor.Position = UDim2.new(0.5, 0, hue, 0)
	end

	local function Fire()
		if config.Callback then
			config.Callback(CurrentColor())
		end
	end

	local function UpdateSV(input)
		local relX = math.clamp((input.Position.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
		local relY = math.clamp((input.Position.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
		sat = relX
		val = 1 - relY
		SVCursor.Position = UDim2.new(sat, 0, 1 - val, 0)
		Fire()
	end

	local function UpdateHue(input)
		local relY = math.clamp((input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
		hue = relY
		SVBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		HueCursor.Position = UDim2.new(0.5, 0, hue, 0)
		Fire()
	end

	SVBox.InputBegan:Connect(function(input)
		if not isOpen then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			UpdateSV(input)
			ActiveDrag = UpdateSV
		end
	end)
	HueBar.InputBegan:Connect(function(input)
		if not isOpen then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			UpdateHue(input)
			ActiveDrag = UpdateHue
		end
	end)

	local function Close()
		if not isOpen then return end
		isOpen = false
		ColorPickerOverlay.Visible = false
		if ActiveColorPickerCloser == Close then
			ActiveColorPickerCloser = nil
		end
	end

	local function Open(anchorButton)
		if ActiveColorPickerCloser and ActiveColorPickerCloser ~= Close then
			ActiveColorPickerCloser()
		end
		isOpen = true
		ActiveColorPickerCloser = Close

		RefreshCursors()

		local pos = anchorButton.AbsolutePosition
		local size = anchorButton.AbsoluteSize
		local screenSize = ScreenGui.AbsoluteSize

		local targetX = pos.X + size.X + 8
		local targetY = pos.Y

		if targetX + 210 > screenSize.X then
			targetX = pos.X - 210 - 8
		end
		if targetY + 170 > screenSize.Y then
			targetY = screenSize.Y - 170 - 8
		end

		ColorPickerOverlay.Position = UDim2.new(0, targetX, 0, targetY)
		ColorPickerOverlay.Visible = true
	end

	local function Toggle(anchorButton)
		if isOpen then
			Close()
		else
			Open(anchorButton)
		end
	end

	return {
		Toggle = Toggle,
		Close = Close,
		Set = function(newColor)
			hue, sat, val = newColor:ToHSV()
			if isOpen then RefreshCursors() end
		end,
		Get = CurrentColor,
	}
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if not ColorPickerOverlay.Visible then return end

	task.defer(function()
		if not ColorPickerOverlay.Visible then return end
		local mousePos = UserInputService:GetMouseLocation()
		local absPos = ColorPickerOverlay.AbsolutePosition
		local absSize = ColorPickerOverlay.AbsoluteSize
		local inside = mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X
			and mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y
		if not inside and ActiveColorPickerCloser then
			ActiveColorPickerCloser()
		end
	end)
end)

